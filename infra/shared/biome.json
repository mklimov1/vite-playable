{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "root": false,
  "vcs": { "enabled": false },
  "files": {
    "includes": ["src/**/*.ts", "!src/shared/generated", "!**/dist"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noStaticOnlyClass": "off"
      },
      "style": {
        "useTemplate": "error",
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noConsole": {
          "level": "warn",
          "options": { "allow": ["warn", "error"] }
        },
        "useIterableCallbackReturn": "off"
      }
    }
  }
}
