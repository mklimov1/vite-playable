{
  "name": "@mklimov1/vite-playable",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "infra-init": "./dist/cli/init.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./assetpack": {
      "import": "./dist/assetpack.js",
      "types": "./dist/assetpack.d.ts"
    }
  },
  "files": [
    "dist",
    "infra"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/assetpack.ts src/cli/init.ts --format esm --dts --external @assetpack/core --external vite-plugin-singlefile --external vite-plugin-zip-pack",
    "prepublishOnly": "npm run build",
    "link": "npm run build && npm link",
    "example": "npm run build && npm -w example run build:inline",
    "test": "npm run build && node --test"
  },
  "workspaces": [
    "examples"
  ],
  "devDependencies": {
    "@assetpack/core": "^1.7.0",
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  },
  "peerDependencies": {
    "@assetpack/core": "^1.0.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@assetpack/core": {
      "optional": true
    }
  },
  "dependencies": {
    "vite-plugin-singlefile": "^2.3.3",
    "vite-plugin-zip-pack": "^1.2.4"
  }
}
